// ==============================================================================
// INVOICEFLOW: Zero-Knowledge Privacy-Preserving Invoice Trust Protocol
// Target Network: Midnight Preprod (Compact Smart Contract Standard v0.15+)
// ==============================================================================

pragma language_version >= 0.15;

import CompactStandardLibrary;

// ------------------------------------------------------------------------------
// Public Ledger State (On-Chain)
// ------------------------------------------------------------------------------
export ledger invoiceRoot: Bytes<32>;
export ledger issuer: ZswapCoinPublicKey;
export ledger invoiceCount: Counter;
export ledger settledCount: Counter;
export ledger nullifiers: Set<Bytes<32>>;

// ------------------------------------------------------------------------------
// Witness Declarations (Private Client-Side Off-Chain Secrets)
// ------------------------------------------------------------------------------
witness invoiceSecret(): Bytes<32>;
witness secretKey(): Bytes<32>;
witness merklePath(): Vector<5, Bytes<32>>;
witness pathDirections(): Vector<5, Boolean>;

// ------------------------------------------------------------------------------
// Constructor (Initializes Genesis Merkle Root & Issuer PK)
// ------------------------------------------------------------------------------
constructor(initialRoot: Bytes<32>) {
  invoiceRoot = disclose(initialRoot);
  issuer = ownPublicKey();
}

// ------------------------------------------------------------------------------
// Register New Invoice Commitment Root (Only Issuer)
// ------------------------------------------------------------------------------
export circuit registerInvoiceRoot(newRoot: Bytes<32>): [] {
  assert(ownPublicKey() == issuer, "only the issuer may update invoice root");
  invoiceRoot = disclose(newRoot);
  invoiceCount.increment(1);
}

// ------------------------------------------------------------------------------
// Leaf and Nullifier Hashes
// ------------------------------------------------------------------------------
circuit leafOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "invoiceflow:leaf"), secret]);
}

circuit nullifierOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "invoiceflow:null"), secret]);
}

circuit merkleRootFrom(
  leaf: Bytes<32>,
  path: Vector<5, Bytes<32>>,
  directions: Vector<5, Boolean>
): Bytes<32> {
  const h0 = directions[0] ? persistentHash<Vector<2, Bytes<32>>>([path[0], leaf]) : persistentHash<Vector<2, Bytes<32>>>([leaf, path[0]]);
  const h1 = directions[1] ? persistentHash<Vector<2, Bytes<32>>>([path[1], h0]) : persistentHash<Vector<2, Bytes<32>>>([h0, path[1]]);
  const h2 = directions[2] ? persistentHash<Vector<2, Bytes<32>>>([path[2], h1]) : persistentHash<Vector<2, Bytes<32>>>([h1, path[2]]);
  const h3 = directions[3] ? persistentHash<Vector<2, Bytes<32>>>([path[3], h2]) : persistentHash<Vector<2, Bytes<32>>>([h2, path[3]]);
  const h4 = directions[4] ? persistentHash<Vector<2, Bytes<32>>>([path[4], h3]) : persistentHash<Vector<2, Bytes<32>>>([h3, path[4]]);
  return h4;
}

// ------------------------------------------------------------------------------
// Verify & Settle Invoice (Zero-Knowledge Proof Verification & Anti-Double-Spend)
// ------------------------------------------------------------------------------
export circuit verifyAndSettleInvoice(): [] {
  const secret = invoiceSecret();
  const leaf = leafOf(secret);
  const path = merklePath();
  const directions = pathDirections();

  const candidateRoot = merkleRootFrom(leaf, path, directions);
  assert(candidateRoot == invoiceRoot, "invalid invoice proof or not part of registered root");

  const nullifier = nullifierOf(secret);
  assert(!nullifiers.member(disclose(nullifier)), "invoice already settled or double-financing prevented");

  nullifiers.insert(disclose(nullifier));
  settledCount.increment(1);
}

// ------------------------------------------------------------------------------
// Get Public Invoice Statistics
// ------------------------------------------------------------------------------
export circuit getInvoiceStats(): [Bytes<32>, Uint<64>, Uint<64>] {
  return [invoiceRoot, invoiceCount as Uint<64>, settledCount as Uint<64>];
}
